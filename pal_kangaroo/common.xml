<mujoco model="common">

    <compiler angle="radian" meshdir="assets/meshes_full" discardvisual="false" strippath="false"/>

    <option iterations="5" ls_iterations="5" timestep="0.001" integrator="implicitfast"/>

    <asset>
        <include file="visual_assets.xml" />
    </asset>

    <default>
        <joint damping="6" frictionloss="1" limited="true" />

        <default class="motor">
            <motor group="0" />
        </default>
        <default class="position">
            <position group="1" kp="60" />
        </default>
        <default class="velocity">
            <velocity group="2" kv="1" />
        </default>

        <default class="collision">
            <geom group="3" rgba="1. 0.65 0. 0.2" type="capsule" />
        </default>

        <default class="box_collision">
            <geom group="3" rgba="1. 0.65 0. 0.2" type="box" />
        </default>

        <default class="visual">
            <geom group="1" conaffinity="0" contype="0" type="mesh" />
        </default>

        <default class="color_midnight_bueno">
            <geom group="1" conaffinity="0" contype="0"
                rgba="0.07059 0.16078 0.18824 1" />
        </default>
        
        <!-- __________________________________________ -->

        <default class="color_midnight">
            <geom group="1" conaffinity="0" contype="0"
                rgba="0.33 0.33 0.33 1" />
        </default>
        <default class="color_metal">
            <geom group="1" conaffinity="0" contype="0"
                rgba="0.66666 0.66275 0.67843 1" />
        </default>
        <default class="color_motor">
            <geom group="1" conaffinity="0" contype="0"
                rgba="0.45 0.45 0.45 1" />
        </default>
        <default class="color_bar">
            <geom group="1" conaffinity="0" contype="0"
                rgba="0.14117 0.14117 0.65882 1" />
        </default>
        
        <!-- __________________________________________ -->

        <default class="color_kangaroo">
            <geom group="1" conaffinity="0" contype="0" type="mesh"
                rgba="0.15625 0.15625 0.15625 1" />
        </default>

    </default>

    <sensor>
      <gyro site="imu" name="gyro"/>
      <velocimeter site="imu" name="local_linvel"/>
      <!-- <accelerometer site="imu" name="accelerometer"/> -->
      <framepos objtype="site" objname="imu" name="position"/>
      <framezaxis objtype="site" objname="imu" name="upvector"/>
      <framexaxis objtype="site" objname="imu" name="forwardvector"/>
      <framelinvel objtype="site" objname="imu" name="global_linvel"/>
      <frameangvel objtype="site" objname="imu" name="global_angvel"/>
      <framequat objtype="site" objname="imu" name="orientation"/>
  
      <framelinvel objtype="site" objname="right_foot" name="right_foot_global_linvel"/>
      <framelinvel objtype="site" objname="left_foot" name="left_foot_global_linvel"/>
    </sensor>

</mujoco>
